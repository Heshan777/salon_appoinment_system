# ==========================================
# Salon Management System - Environment Variables
# ==========================================

# --- API Gateway ---
PORT=5000
NODE_ENV=development
AUTH_SERVICE_URL=http://localhost:5001
BOOKING_SERVICE_URL=http://localhost:5002
CATALOG_SERVICE_URL=http://localhost:5003
PAYMENT_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
AI_SERVICE_URL=http://localhost:5006

# --- Auth Service (Supabase) ---
AUTH_PORT=5001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your_jwt_secret_key_for_fallback

# --- Booking Service (MongoDB Atlas) ---
BOOKING_PORT=5002
MONGODB_URI=mongodb://localhost:27017/salon_bookings
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/salon_bookings?retryWrites=true&w=majority

# --- Catalog Service (MongoDB Atlas) ---
CATALOG_PORT=5003
MONGODB_CATALOG_URI=mongodb://localhost:27017/salon_catalog
# For MongoDB Atlas:
# MONGODB_CATALOG_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/salon_catalog?retryWrites=true&w=majority

# --- Payment Service ---
PAYMENT_PORT=5004
STRIPE_SECRET_KEY=sk_test_placeholder_key

# --- Notification Service ---
NOTIFICATION_PORT=5005
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass

# --- AI Assistant Service (Gemini API) ---
AI_PORT=5006
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
